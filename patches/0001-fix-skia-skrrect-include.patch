From 4d977e1c8f9b8cb7efb4e9fd4f76a1f9f7f2b3ad Mon Sep 17 00:00:00 2001
From: Codex <codex@openai>
Date: Thu, 5 Mar 2026 16:30:00 -0300
Subject: [PATCH] Include SkRRect header for round-rect parsing with newer Skia

Some Skia package variants only forward-declare `SkRRect` in `SkPath.h`.
`SkPath::addRoundRect(...)` then fails to compile unless `SkRRect.h` is
included explicitly.
---
 ext/import-svg.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/ext/import-svg.cpp b/ext/import-svg.cpp
index 752f798..ca802f0 100644
--- a/ext/import-svg.cpp
+++ b/ext/import-svg.cpp
@@ -26,6 +26,7 @@
 
 #ifdef MSDFGEN_USE_SKIA
 #include <skia/core/SkPath.h>
+#include <skia/core/SkRRect.h>
 #include <skia/utils/SkParsePath.h>
 #include <skia/pathops/SkPathOps.h>
 #endif
-- 
